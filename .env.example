# Application
NEXT_PUBLIC_APP_NAME=Surgical Narration Lab
NEXT_PUBLIC_APP_TAGLINE=Research platform for surgical video narration

# Required for signed session cookies (use a long random string in production)
AUTH_SECRET=replace-with-a-long-random-secret

# Local MVP storage (default when Supabase is not configured)
# data/ holds SQLite DB + uploaded media on disk
STORAGE_BACKEND=local
DATA_DIR=./data

# Optional size limits (bytes). Default video limit is 300 MB.
# MAX_VIDEO_BYTES=314572800
# MAX_AUDIO_BYTES=104857600
NODE_VERSION=22

# --- Production / Supabase (optional for this MVP) ---
# When set, use these for a future Supabase-backed deployment.
# The current MVP runs fully in local mode without them.
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
