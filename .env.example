# Application
NEXT_PUBLIC_APP_NAME=Surgical Operative Note Lab
NEXT_PUBLIC_APP_TAGLINE=Research platform for surgical operative note dictation

# Required for signed session cookies (use a long random string in production)
AUTH_SECRET=replace-with-a-long-random-secret

# Comma-separated emails that always get full admin access (same capabilities).
# ADMIN_EMAILS=ritaglaz@buffalo.edu,pseger@buffalo.edu

# Local MVP storage (default when Supabase is not configured)
# data/ holds SQLite DB + uploaded media on disk
STORAGE_BACKEND=local
DATA_DIR=./data

# Optional size limits (bytes). Default video limit is 300 MB.
# MAX_VIDEO_BYTES=314572800
# MAX_AUDIO_BYTES=104857600
NODE_VERSION=22

# --- Production / Supabase (optional for this MVP) ---
# When set, use these for a future Supabase-backed deployment.
# The current MVP runs fully in local mode without them.
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Google Drive sync (audio + JSON only; videos stay on the server) ---
# Personal Gmail My Drive needs OAuth (service accounts lack My Drive quota).
# See docs/GOOGLE_DRIVE_SETUP.md — never put your Google password here.
# GOOGLE_DRIVE_SYNC=true
# GOOGLE_DRIVE_FOLDER_ID=your_folder_id_from_drive_url
# GOOGLE_OAUTH_CLIENT_ID=....apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=....
# GOOGLE_OAUTH_REFRESH_TOKEN=....
# Shared Drives / Workspace only:
# GOOGLE_SERVICE_ACCOUNT_JSON_PATH=/absolute/path/to/service-account.json

# --- Invite emails (optional; without these, admins copy invite links) ---
# NEXT_PUBLIC_APP_URL=https://surgical-operative-note-lab.onrender.com
# RESEND_API_KEY=re_...
# EMAIL_FROM="Surgical Operative Note Lab <onboarding@resend.dev>"
# INVITE_EXPIRY_DAYS=30
